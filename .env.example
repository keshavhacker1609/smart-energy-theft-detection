# Copy to .env (repo root, read by predict.py) and/or backend/.env (read by the API).

# Published QuickML endpoint: QuickML > Endpoints > <your endpoint> shows the URL
# (https://api.catalyst.zoho.<dc>/quickml/v1/project/<project_id>/endpoints/predict)
# and the endpoint key.
QUICKML_ENDPOINT_URL=
QUICKML_ENDPOINT_KEY=

# Zoho OAuth self-client (api-console.zoho.<dc>), scope QuickML.deployment.READ (shown on the endpoint page).
# The refresh token never expires, so predict.py keeps working for evaluators.
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ACCOUNTS_URL=https://accounts.zoho.com
# Alternative to the three ZOHO_* values above: a short-lived access token.
QUICKML_ACCESS_TOKEN=
# Catalyst organisation id, sent as the CATALYST-ORG header when set.
CATALYST_ORG_ID=
# Sent as the Environment header: Development until the project is deployed to production.
CATALYST_ENVIRONMENT=Development

QUICKML_TIMEOUT_S=15
QUICKML_MAX_RETRIES=3
QUICKML_MAX_WORKERS=16

# API only.
STORAGE_BACKEND=local
STRATUS_BUCKET=telemetry-uploads
DATASTORE_RUNS_TABLE=ForecastRuns
DATASTORE_HOURS_TABLE=ForecastHours
CORS_ORIGINS=["http://localhost:5173"]
