# Published QuickML endpoint. Copy the URL and headers from the endpoint's
# sample request in the Catalyst console (QuickML > Endpoints > your endpoint).
QUICKML_ENDPOINT_URL=
# Credential sent as "Authorization: <QUICKML_AUTH_SCHEME> <QUICKML_API_KEY>".
QUICKML_API_KEY=
QUICKML_AUTH_SCHEME=
# Any additional headers the sample request uses, as a JSON object,
# e.g. {"CATALYST-ORG": "<org id>"}.
QUICKML_EXTRA_HEADERS=
QUICKML_BATCH_SIZE=200
QUICKML_TIMEOUT_S=15
QUICKML_MAX_RETRIES=3
